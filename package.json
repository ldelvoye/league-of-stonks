{
  "name": "league-of-stonks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "tsc",
    "build:frontend": "tsc -p frontend/tsconfig.json",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "node backend/dist/index.js",
    "local:dev:backend": "tsx backend/index.ts",
    "local:dev:frontend": "tsc -p frontend/tsconfig.json --watch",
    "local:start:frontend": "npx serve frontend -l 3001",
    "dev": "npm run local:dev:backend",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx backend/db/migrate.ts",
    "db:seed": "tsx scripts/seed-test-player.ts"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
