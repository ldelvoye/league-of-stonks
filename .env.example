RIOT_API_KEY=
DATABASE_URL=
# Comma-separated list of frontend origins allowed to call the backend API.
# Local split setup default: http://localhost:3001
ALLOWED_ORIGINS=
RESEND_API_KEY=
# Public URL of the app, used to build verification links.
APP_BASE_URL=https://leagueofstonks.com
EMAIL_FROM=no-reply@leagueofstonks.com

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Shared secret protecting /api/jobs/* endpoints. Required to enable cron jobs.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Cron trigger script (set on Railway Cron service, not backend) ────────────
# Which sync to run: 'leaderboard' or 'random-discovery'
# (Set on the Railway Cron service — start command: node scripts/trigger-riot-history-sync.js)
SYNC_MODE=leaderboard
# Base URL of the deployed backend (no trailing slash)
API_BASE_URL=https://api.leagueofstonks.com

# ── Advanced Riot API tuning (optional, sane defaults provided) ───────────────
# Conservative per-window budgets. Riot limits: 20/1s and 100/2min.
# RIOT_OUTBOUND_LIMIT_PER_SECOND=18
# RIOT_OUTBOUND_LIMIT_PER_2MIN=90
# Cron skips work when this many Riot calls have been made in the last 2 min.
# CRON_RIOT_BUDGET_THRESHOLD=70
